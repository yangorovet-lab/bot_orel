# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Твой chat id (напиши боту @userinfobot)
TELEGRAM_CHAT_ID=123456789

# Даты поездки через запятую. Если пусто — ближайшие DAYS_AHEAD дней
DATES=2026-10-17,2026-10-18
DAYS_AHEAD=3

# Станции (по умолчанию Орёл -> Москва, все вокзалы)
FROM_STATION=ОРЕЛ
TO_STATION=МОСКВА
FROM_CODE=2000140
TO_CODE=2000000

# Фильтры (необязательно)
# TRAINS=064,742          # только эти поезда (по началу номера)
# CAR_TYPES=КУПЕ,СВ       # ПЛАЦ, КУПЕ, СВ, СИД, ЛЮКС
# MAX_PRICE=5000
# TIME_FROM=06:00
# TIME_TO=20:00

# Пауза между проверками, минуты (случайно в диапазоне)
INTERVAL_MIN=5
INTERVAL_MAX=10
